{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "site-dev"
    }
  ],
  "observability": {
    "enabled": false
  },
  "env": {
    "production": {
      "name": "site-production",
      "workers_dev": false,
      "preview_urls": false,
      "keep_names": true,
      "route": {
        "custom_domain": true,
        "pattern": "site.xn--zambpovopreto-slb.com.br",
        "zone_name": "xn--zambpovopreto-slb.com.br"
      },
      "assets": {
        "binding": "ASSETS",
        "directory": ".open-next/assets"
      },
      "images": {
        "binding": "IMAGES"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "site"
        }
      ],
      "observability": {
        "enabled": true
      }
    }
  }
}
